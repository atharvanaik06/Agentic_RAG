# Runtime
RAG_ENVIRONMENT=development
RAG_LOG_LEVEL=INFO
RAG_LOG_FORMAT=console

# Local storage
RAG_DATA_DIR=data/raw
RAG_INDEX_DIR=data/indexes
RAG_CHROMA_DIR=data/indexes/chroma
RAG_CHROMA_COLLECTION=advanced-rag

# Ingestion
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=75
RAG_MIN_CHUNK_SIZE=50
RAG_TOKEN_ENCODING=cl100k_base

# Dense embeddings
RAG_EMBEDDING_PROVIDER=openai
RAG_EMBEDDING_MODEL=text-embedding-3-small
RAG_EMBEDDING_DIMENSIONS=1536
RAG_EMBEDDING_BATCH_SIZE=100

# Sparse retrieval
RAG_BM25_DIR=data/indexes/bm25
RAG_BM25_METHOD=lucene
RAG_BM25_K1=1.5
RAG_BM25_B=0.75

# Hybrid retrieval and reranking
RAG_HYBRID_CANDIDATE_K=15
RAG_HYBRID_RERANK_K=15
RAG_HYBRID_RRF_K=60
RAG_HYBRID_CONTEXT_TOKEN_BUDGET=3000
RAG_HYBRID_MAX_CHUNKS_PER_SOURCE=3
RAG_HYBRID_MAX_CHUNKS_PER_PAGE=2
RAG_RERANKER_PROVIDER=flashrank
RAG_RERANKER_MODEL=ms-marco-TinyBERT-L-2-v2
RAG_RERANKER_CACHE_DIR=data/models/flashrank
RAG_RERANKER_MAX_LENGTH=512

# Agent graph and answer generation
RAG_CHAT_PROVIDER=openai
RAG_CHAT_MODEL=gpt-4o-mini
RAG_CHAT_MAX_OUTPUT_TOKENS=1200
RAG_AGENT_MAX_RETRIEVAL_ATTEMPTS=2
RAG_AGENT_MAX_STEPS=8
RAG_AGENT_TOP_K=6
RAG_AGENT_SEMANTIC_EVIDENCE_GRADING=true
RAG_AGENT_SCOPE_DESCRIPTION=monetary policy, central banking, and macro-financial research
RAG_AGENT_SCOPE_TERMS=monetary,inflation,disinflation,central bank,central banking,federal reserve,fed,fomc,ecb,bis,interest rate,policy rate,financial stress,financial condition,prices,wages,profits,employment,labor market,economic growth,macroeconomic,term premium,yield

# Streamlit session spending guards (0 disables a limit)
RAG_UI_SESSION_QUESTION_LIMIT=10
RAG_UI_SESSION_API_CALL_LIMIT=20
RAG_UI_SESSION_TOKEN_BUDGET=50000
RAG_UI_MAX_UPLOAD_MB=100

# Evaluation and regression gates
RAG_EVALUATION_DIR=reports
RAG_EVALUATION_ENTAILMENT_MODEL=gpt-4o-mini
RAG_EVALUATION_HYBRID_RECALL_THRESHOLD=0.75
RAG_EVALUATION_CITATION_VALIDITY_THRESHOLD=1.0
RAG_EVALUATION_REFUSAL_ACCURACY_THRESHOLD=0.8
RAG_EVALUATION_MAX_AVERAGE_ATTEMPTS=1.5

# Model providers (configure when model integrations are added)
RAG_OPENAI_API_KEY=
RAG_ANTHROPIC_API_KEY=

# Optional observability
RAG_LANGSMITH_API_KEY=
RAG_LANGSMITH_TRACING=false

# Optional web-search fallback
RAG_ENABLE_WEB_SEARCH=false
